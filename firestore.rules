rules_version = '2';

// Reglas de seguridad de la agenda.
// Copia TODO este archivo en Firebase → Firestore Database → Reglas → Publicar.
// Reemplaza CORREO_ADMIN por el correo con el que entras al panel.
// La capacidad (2 autos a la vez) está en el "[12]" de idSlot: para 3 autos usa "[123]".

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null && request.auth.token.email == 'CORREO_ADMIN';
    }

    function idSlot(id) {
      // AAAA-MM-DD_HH_N  (N = puesto 1 o 2)
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}_[12]$');
    }

    function texto(v, max) {
      return v is string && v.size() <= max;
    }

    // Horas ocupadas: públicas (sin datos personales) para mostrar disponibilidad.
    match /slots/{id} {
      allow read: if true;
      // El cliente solo puede ocupar una hora LIBRE (create falla si ya existe)
      // y solo junto con una reserva nueva creada en la misma operación.
      allow create: if idSlot(id) && (
        esAdmin() || (
          request.resource.data.keys().hasOnly(['fecha', 'hora', 'tipo', 'reserva']) &&
          request.resource.data.tipo == 'reserva' &&
          request.resource.data.fecha == id.split('_')[0] &&
          !exists(/databases/$(database)/documents/reservas/$(request.resource.data.reserva)) &&
          existsAfter(/databases/$(database)/documents/reservas/$(request.resource.data.reserva))
        )
      );
      allow update, delete: if esAdmin();
    }

    // Reservas con datos del cliente: solo el administrador puede verlas.
    match /reservas/{id} {
      allow create: if esAdmin() || (
        request.resource.data.keys().hasOnly([
          'fecha', 'hora', 'duracion', 'servicio', 'vehiculoTipo', 'total',
          'nombre', 'telefono', 'email', 'vehiculo', 'patente', 'notas',
          'slots', 'estado', 'creado'
        ]) &&
        request.resource.data.estado == 'pendiente' &&
        texto(request.resource.data.nombre, 80) &&
        texto(request.resource.data.telefono, 30) &&
        texto(request.resource.data.email, 120) &&
        texto(request.resource.data.vehiculo, 80) &&
        texto(request.resource.data.patente, 12) &&
        texto(request.resource.data.notas, 600) &&
        request.resource.data.slots is list &&
        request.resource.data.slots.size() <= 12
      );
      allow read, update, delete: if esAdmin();
    }
  }
}
